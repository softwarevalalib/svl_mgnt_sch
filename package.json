{
  "name": "svl-sms",
  "version": "1.0.0",
  "description": "SVL School Management System - Desktop & Web",
  "main": "dist/electron/main.js",
  "homepage": "https://github.com/itconsultantbryant-svg/svl_sms",
  "author": "SVL-SMS Team",
  "license": "Proprietary",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/index.js",
    "generate-license": "node tools/generate-license.js",
    "build:frontend": "cd frontend && npm install --include=dev --legacy-peer-deps && npm run build",
    "build:frontend:electron": "cd frontend && npm install --include=dev --legacy-peer-deps && npm run build:electron",
    "build:backend": "tsc --project tsconfig.json",
    "build:electron": "tsc --project tsconfig.electron.json",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run build:electron && electron .\"",
    "electron:prepare": "node scripts/prepare-electron-dist.js",
    "electron-build": "npm run electron:prepare && electron-builder --config electron-builder.config.js",
    "electron-build:win": "npm run electron:prepare && electron-builder --config electron-builder.config.js --win nsis --x64",
    "electron-build:win:zip": "npm run electron-build:win && node scripts/package-win-zip.js",
    "electron-build:mac": "npm run electron:prepare && electron-builder --config electron-builder.config.js --mac",
    "electron-build:linux": "npm run electron:prepare && electron-builder --config electron-builder.config.js --linux",
    "electron-pack": "npm run electron:prepare && electron-builder --config electron-builder.config.js --dir",
    "electron-dist": "electron-builder --config electron-builder.config.js"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "electron-is-dev": "^2.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "typescript": "^5.5.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/pg": "^8.15.5",
    "@vercel/functions": "^3.1.0",
    "archiver": "^7.0.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "tsx": "^4.7.0",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
